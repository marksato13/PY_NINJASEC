export async function getDevices(
  token: string,
  filters?: { client_id?: number; integration_id?: number; site_id?: number; device_status?: string },
): Promise<DeviceItem[]> {
  const params = new URLSearchParams();
  if (filters?.client_id) params.set("client_id", String(filters.client_id));
  if (filters?.integration_id) params.set("integration_id", String(filters.integration_id));
  if (filters?.site_id) params.set("site_id", String(filters.site_id));
  if (filters?.device_status) params.set("device_status", filters.device_status);
  const suffix = params.toString() ? `?${params.toString()}` : "";
  return request<DeviceItem[]>(`/devices/${suffix}`, {
    headers: { Authorization: `Bearer ${token}` },
  });
}

