export async function getProjectRecommendations(
  token: string,
  projectId: number,
  refresh = false,
): Promise<ProjectRecommendationItem[]> {
  const suffix = refresh ? `?project_id=${projectId}&refresh=true` : `?project_id=${projectId}`;
  return request<ProjectRecommendationItem[]>(`/project-recommendations${suffix}`, {
    headers: { Authorization: `Bearer ${token}` },
  });
}

