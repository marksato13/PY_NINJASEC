# ════════════════════════════════════════════════════════════════════
# NinjaSec — Variables de entorno
# ════════════════════════════════════════════════════════════════════
# Copiá este archivo a .env y completá los valores.
# NUNCA commitear .env al repositorio.
# ════════════════════════════════════════════════════════════════════

# ─── PostgreSQL ─────────────────────────────────────────────────────
POSTGRES_DB=ninjasec
POSTGRES_USER=postgres
# Generar con: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
# En prod (VLAN30 DC): host del Postgres remoto, ej. 172.16.30.5
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Backend ────────────────────────────────────────────────────────
APP_NAME=NinjaSec
APP_VERSION=0.2.0
API_PREFIX=/api/v1

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_random_64_char_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CSV de orígenes permitidos
# Dev:  http://localhost:3018,http://127.0.0.1:3018
# Prod: https://ninjasec.duckdns.org
CORS_ORIGINS=http://localhost:3018

# Seed automático en arranque (true=dev, false=prod)
SEED_ON_STARTUP=true
# Modo producción (deshabilita /docs, exige JWT_SECRET seguro)
IS_PRODUCTION=false

# ─── Frontend ───────────────────────────────────────────────────────
# Relativo: usa el proxy de Next.js (recomendado, no cambiar)
NEXT_PUBLIC_API_URL=/api/v1
# URL interna del backend (DNS interno de Docker)
BACKEND_INTERNAL_URL=http://backend:8024

# ─── Producción (DuckDNS / Dominio) ─────────────────────────────────
# Solo para deploy
DOMAIN=ninjasec.duckdns.org
DUCKDNS_TOKEN=
# Email para certificados Let's Encrypt
ACME_EMAIL=tu-email@ejemplo.com
