# Variables de entorno para Docker Compose
# Copia este archivo a infra/.env y ajusta los valores según tu entorno

# URL que el frontend usa para llamar al backend
# Desarrollo local:
NEXT_PUBLIC_API_URL=http://localhost:8024/api/v1

# Red interna (universidad, trabajo):
# NEXT_PUBLIC_API_URL=http://192.168.1.x:8024/api/v1

# Producción:
# NEXT_PUBLIC_API_URL=https://api.tudominio.com/api/v1
